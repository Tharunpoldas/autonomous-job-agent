# Copy these into backend/.env and keep the real file private.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
ADZUNA_APP_ID=YOUR_ADZUNA_APP_ID
ADZUNA_APP_KEY=YOUR_ADZUNA_APP_KEY
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Use a sender on a domain verified in Resend for real recruiter delivery.
EMAIL_FROM=Career Agent <jobs@your-verified-domain.com>
SESSION_DAYS=30

# Gmail / Outlook OAuth (required for inbox status tracking)
FRONTEND_URL=http://localhost:5173
EMAIL_SYNC_INTERVAL_SECONDS=300

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/gmail/callback

MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/email/outlook/callback
MICROSOFT_TENANT=common
